            "Parameters": {
              "name": "Dormant Account Reactivation Draft",
              "destination": "MarketingCloud",
              "segmentId.$": "$.create_segment.segmentId"
            },
            "ResultPath": "$.create_activation",
            "Next": "monitor_goal"
          },
          "monitor_goal": {
            "Type": "Task",
            "Comment": "Monitor activation rate",
            "Resource": "urn:salesforce:data360:capability:monitor.metric",
            "Parameters": {
              "metric": "activation_rate",
