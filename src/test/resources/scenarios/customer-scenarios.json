    "goldenPlan": {
      "schemaVersion": "data360-asl-profile-2026-05-31",
      "id": "plan_travel_ltv_snowflake_crm",
      "scenarioId": "travel_ltv_snowflake_crm",
      "goal": "Create a travel LTV audience from Snowflake bookings and CRM contacts",
      "context": {
        "org": "demo-org",
        "dataspace": "default",
        "environment": "sandbox"
      },
      "definition": {
        "Version": "1.0",
        "QueryLanguage": "JSONPath",
        "StartAt": "describe_metadata",
        "States": {
          "describe_metadata": {
            "Type": "Task",
            "Comment": "Describe travel audience metadata",
            "Resource": "urn:salesforce:data360:capability:metadata.describe",
            "Parameters": {
              "objects": [
                "UnifiedIndividual",
                "TravelCustomerDLO",
                "TravelItineraryDLO",
                "TravelItineraryOrderDLO",
                "Individual",
                "TravelItinerary",
                "Segment",
                "Activation"
              ]
            },
            "ResultPath": "$.describe_metadata",
            "Next": "create_customer_stream"
          },
          "create_customer_stream": {
            "Type": "Task",
            "Comment": "Create Snowflake customer data stream",
            "Resource": "urn:salesforce:data360:capability:dataStream.snowflake.create",
            "Parameters": {
              "streamName": "travel_customer_stream",
              "label": "Travel Customer Stream",
              "connectionName": "Snowflake DCBOOTCAMP",
              "database": "DCBOOTCAMP",
              "schema": "PUBLIC",
              "objectName": "CUSTOMER",
              "dataSpaceName": "default",
              "dloName": "TravelCustomerDLO",
              "dloLabel": "Travel Customer DLO",
              "category": "Profile",
              "refreshMode": "Scheduled"
            },
            "ResultPath": "$.create_customer_stream",
            "Next": "create_itinerary_stream"
          },
          "create_itinerary_stream": {
            "Type": "Task",
            "Comment": "Create Snowflake itinerary data stream",
            "Resource": "urn:salesforce:data360:capability:dataStream.snowflake.create",
            "Parameters": {
              "streamName": "travel_itinerary_stream",
              "label": "Travel Itinerary Stream",
              "connectionName": "Snowflake DCBOOTCAMP",
              "database": "DCBOOTCAMP",
              "schema": "PUBLIC",
              "objectName": "ITINERARY",
              "dataSpaceName": "default",
              "dloName": "TravelItineraryDLO",
              "dloLabel": "Travel Itinerary DLO",
              "category": "Engagement",
              "refreshMode": "Scheduled"
            },
            "ResultPath": "$.create_itinerary_stream",
            "Next": "create_order_stream"
          },
          "create_order_stream": {
            "Type": "Task",
            "Comment": "Create Snowflake itinerary order data stream",
            "Resource": "urn:salesforce:data360:capability:dataStream.snowflake.create",
            "Parameters": {
              "streamName": "travel_itinerary_order_stream",
              "label": "Travel Itinerary Order Stream",
              "connectionName": "Snowflake DCBOOTCAMP",
              "database": "DCBOOTCAMP",
              "schema": "PUBLIC",
              "objectName": "ITINERARY_ORDER",
              "dataSpaceName": "default",
              "dloName": "TravelItineraryOrderDLO",
              "dloLabel": "Travel Itinerary Order DLO",
              "category": "Engagement",
              "refreshMode": "Scheduled"
            },
            "ResultPath": "$.create_order_stream",
            "Next": "create_contact_stream"
          },
          "create_contact_stream": {
            "Type": "Task",
            "Comment": "Create CRM contact data stream",
            "Resource": "urn:salesforce:data360:capability:dataStream.crm.create",
            "Parameters": {
              "streamName": "crm_contact_stream",
              "label": "CRM Contact Stream",
              "sourceObject": "Contact",
              "dataSpaceName": "default",
              "dloName": "ContactDLO",
              "dloLabel": "Contact DLO",
              "category": "Profile"
            },
            "ResultPath": "$.create_contact_stream",
            "Next": "map_customer_to_individual"
          },
          "map_customer_to_individual": {
            "Type": "Task",
            "Comment": "Map Snowflake customer DLO to Individual",
            "Resource": "urn:salesforce:data360:capability:mapping.create",
            "Parameters": {
              "sourceDloName": "TravelCustomerDLO",
              "targetDmoName": "Individual",
              "dataspace": "default",
              "fieldMappings": {
                "externalCustomerId": "externalCustomerId",
                "email": "email",
                "loyaltyTier": "loyalty_tier"
              }
            },
            "ResultPath": "$.map_customer_to_individual",
            "Next": "map_contact_to_individual"
          },
          "map_contact_to_individual": {
            "Type": "Task",
            "Comment": "Map CRM contact DLO to Individual",
            "Resource": "urn:salesforce:data360:capability:mapping.create",
            "Parameters": {
              "sourceDloName": "ContactDLO",
              "targetDmoName": "Individual",
              "dataspace": "default",
              "fieldMappings": {
                "Contact.Id": "crmContactId",
                "Contact.Email": "email",
                "Contact.Name": "fullName"
              }
            },
            "ResultPath": "$.map_contact_to_individual",
            "Next": "map_order_to_itinerary"
          },
          "map_order_to_itinerary": {
            "Type": "Task",
            "Comment": "Map Snowflake itinerary order DLO to TravelItinerary",
            "Resource": "urn:salesforce:data360:capability:mapping.create",
            "Parameters": {
              "sourceDloName": "TravelItineraryOrderDLO",
              "targetDmoName": "TravelItinerary",
              "dataspace": "default",
              "fieldMappings": {
                "customer_id": "externalCustomerId",
                "order_amount": "transactionAmount",
                "itinerary_id": "itineraryId"
              }
            },
            "ResultPath": "$.map_order_to_itinerary",
            "Next": "create_identity_ruleset"
          },
          "create_identity_ruleset": {
            "Type": "Task",
            "Comment": "Create travel identity ruleset",
            "Resource": "urn:salesforce:data360:capability:identityResolution.ruleset.create",
            "Parameters": {
              "name": "Travel Customer Identity Ruleset",
              "description": "Link CRM contacts to Snowflake customer records by email and external customer id.",
              "profileObject": "Individual",
              "rules": [
                {
                  "name": "Exact email",
                  "fields": [
                    "email"
                  ]
                },
                {
                  "name": "Exact external customer id",
                  "fields": [
                    "externalCustomerId"
                  ]
                }
              ]
            },
            "ResultPath": "$.create_identity_ruleset",
            "Next": "run_identity_resolution"
          },
          "run_identity_resolution": {
            "Type": "Task",
            "Comment": "Run travel identity resolution",
            "Resource": "urn:salesforce:data360:capability:identityResolution.run",
            "Parameters": {
              "rulesetId.$": "$.create_identity_ruleset.rulesetId"
            },
            "ResultPath": "$.run_identity_resolution",
            "Next": "create_lifetime_value_insight"
          },
          "create_lifetime_value_insight": {
            "Type": "Task",
            "Comment": "Create travel customer lifetime value insight",
            "Resource": "urn:salesforce:data360:capability:calculatedInsight.create",
            "Parameters": {
              "name": "Travel Customer Lifetime Value",
              "description": "SUM TravelItinerary.transactionAmount by unified individual after identity resolution links CRM Contact to Snowflake customer records.",
              "unifiedProfileObjectApiName.$": "$.run_identity_resolution.unifiedProfileObjectApiName",
              "unifiedProfileIdField.$": "$.run_identity_resolution.unifiedProfileIdField",
              "transactionObjectApiName": "TravelItinerary",
              "transactionCustomerKeyField": "externalCustomerId",
              "measure": {
                "type": "SUM",
                "field": "transactionAmount",
                "alias": "lifetime_value"
              },
              "groupBy": [
                "unified_individual_id"
              ]
            },
            "ResultPath": "$.create_lifetime_value_insight",
            "Next": "run_lifetime_value_insight"
          },
          "run_lifetime_value_insight": {
            "Type": "Task",
            "Comment": "Run travel customer lifetime value insight",
            "Resource": "urn:salesforce:data360:capability:calculatedInsight.run",
            "Parameters": {
              "insightId.$": "$.create_lifetime_value_insight.insightId"
            },
            "ResultPath": "$.run_lifetime_value_insight",
            "Next": "preview_audience"
          },
          "preview_audience": {
            "Type": "Task",
            "Comment": "Preview high LTV travelers",
            "Resource": "urn:salesforce:data360:capability:query",
            "Parameters": {
              "sql": "SELECT unified_individual_id, email, loyalty_tier, lifetime_value, itinerary_count, last_booking_date FROM UnifiedIndividual WHERE lifetime_value > 10000 AND marketing_consent = 'OptIn' LIMIT 100",
              "limit": 100
            },
            "ResultPath": "$.preview_audience",
            "Next": "create_segment"
          },
          "create_segment": {
            "Type": "Task",
            "Comment": "Create high LTV traveler segment",
            "Resource": "urn:salesforce:data360:capability:segment.create",
            "Parameters": {
              "name": "High LTV Travelers",
              "description": "Unified individuals with lifetime_value greater than 10000, opt-in marketing consent, and recent itinerary activity.",
              "criteriaFromStep": "preview_audience"
            },
            "ResultPath": "$.create_segment",
            "Next": "publish_segment"
          },
          "publish_segment": {
            "Type": "Task",
            "Comment": "Publish high LTV traveler segment",
            "Resource": "urn:salesforce:data360:capability:segment.publish",
            "Parameters": {
              "segmentId.$": "$.create_segment.segmentId"
            },
            "ResultPath": "$.publish_segment",
            "Next": "create_activation"
          },
          "create_activation": {
            "Type": "Task",
            "Comment": "Create travel LTV activation",
            "Resource": "urn:salesforce:data360:capability:activation.create",
            "Parameters": {
              "name": "Travel LTV Activation Draft",
              "destination": "MarketingCloud",
              "segmentId.$": "$.create_segment.segmentId"
            },
            "ResultPath": "$.create_activation",
            "Next": "monitor_activation"
          },
          "monitor_activation": {
            "Type": "Task",
            "Comment": "Monitor high LTV activation rate",
            "Resource": "urn:salesforce:data360:capability:monitor.metric",
            "Parameters": {
              "metric": "high_ltv_activation_rate",
              "cadence": "daily",
              "threshold": {
                "operator": "<",
                "value": 0.2
              },
              "queryFromStep": "preview_audience"
            },
            "ResultPath": "$.monitor_activation",
            "End": true
          }
        }
      }
    }
  }
]
